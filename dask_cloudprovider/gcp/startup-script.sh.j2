#!/bin/bash
set -euo pipefail

# Dask Cloud Provider GCP startup script.
# Executed by the GCE guest agent via the "startup-script" metadata key.
# Works reliably on all GCE images (Ubuntu, COS, Debian, etc.).

{% if bootstrap %}
# --- Bootstrap: install Docker ---
export DEBIAN_FRONTEND=noninteractive

# Install prerequisites
apt-get update -y
apt-get install -y apt-transport-https ca-certificates curl gnupg software-properties-common

# Install Docker using the official convenience script (works on all supported distros)
curl -fsSL https://get.docker.com | sh

# Start Docker
systemctl start docker
systemctl enable docker
{% endif %}

{% if bootstrap and gpu_instance %}
# --- Install NVIDIA drivers and nvidia-docker ---
ubuntu-drivers install

curl -fsSL https://nvidia.github.io/nvidia-docker/gpgkey | apt-key add -
curl -s -L https://nvidia.github.io/nvidia-docker/$(. /etc/os-release;echo $ID$VERSION_ID)/nvidia-docker.list | tee /etc/apt/sources.list.d/nvidia-docker.list
apt-get update -y
apt-get install -y nvidia-docker2
systemctl restart docker
{% endif %}

{% if extra_bootstrap %}
# --- Extra bootstrap commands ---
{% for command in extra_bootstrap %}
{{ command }}
{% endfor %}
{% endif %}

{% if not bootstrap %}
# --- Open local firewall for Dask traffic ---
# COS has a restrictive iptables INPUT policy (DROP) that blocks inbound
# connections even when VPC firewall rules allow them. Accept all traffic
# from the GCP internal VPC range (scheduler<->worker, worker<->worker on
# random ports) and open the scheduler/dashboard ports for external clients.
if command -v iptables &> /dev/null && iptables -S INPUT 2>/dev/null | grep -q -- "-P INPUT DROP"; then
  iptables -A INPUT -s {{ vpc_cidr }} -j ACCEPT
  iptables -A INPUT -p tcp --dport {{ scheduler_port }} -j ACCEPT
  iptables -A INPUT -p tcp --dport {{ dashboard_port }} -j ACCEPT
fi
{% endif %}

{% if image.split('/')[0].endswith('.pkg.dev') or image.split('/')[0] == 'gcr.io' or image.split('/')[0].endswith('.gcr.io') %}
# --- Configure Docker credentials for GCP registry ---
# COS only pre-configures docker-credential-gcr for gcr.io, not *.pkg.dev.
{% if bootstrap %}
# On non-COS images, install docker-credential-gcr.
curl -fsSL "https://github.com/GoogleCloudPlatform/docker-credential-gcr/releases/download/v2.1.25/docker-credential-gcr_linux_amd64-2.1.25.tar.gz" \
  | tar xz -C /usr/local/bin docker-credential-gcr
chmod +x /usr/local/bin/docker-credential-gcr
docker-credential-gcr version
# /root is writable on non-COS images.
export HOME=/root
mkdir -p /root/.docker
{% else %}
# COS has read-only /root; use /home/chronos for Docker config.
export HOME=/home/chronos
mkdir -p "$HOME/.docker"
{% endif %}
docker-credential-gcr configure-docker --registries="{{ image.split('/')[0] }}"
{% endif %}

# --- Run Dask container ---
# NOTE: extra_bootstrap commands are rendered verbatim — callers must not pass
# untrusted input.  The template does not sanitize them.
{% if auto_shutdown %}
# Ensure VM shuts down even if docker run fails (OOM, crash, etc.)
trap 'shutdown -h now' EXIT
{% endif %}
docker run --net=host{% if gpu_instance %} --gpus=all{% endif %}{% for key in env_vars %} -e {{ key }}={{ env_vars[key] }}{% endfor %}{% if docker_args %} {{ docker_args }}{% endif %} {{ image }} {{ command }}
